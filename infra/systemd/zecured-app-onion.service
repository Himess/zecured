# The app's onion build: the same build environment as the public app, with NEXT_PUBLIC_BACKEND_URL set
# to http://<onion address>/api (see infra/README.md, "Onion service"). Served to the onion service only.
[Unit]
Description=Zecured app, onion build
After=network-online.target zecured-backend.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=zecured
Group=zecured
WorkingDirectory=/opt/zecured/app-onion
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=-/opt/zecured/app-onion/.next/cache

[Install]
WantedBy=multi-user.target
