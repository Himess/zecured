# /etc/zecured/watchdog.env: every threshold and endpoint of infra/watchdog/watchdog.py (G1, G2, G3).
BACKEND_URL=http://127.0.0.1:8080
BASE_RPC_URL=https://sepolia.base.org

# The header relay must stay within this many Zcash blocks of the tip (25 s blocks: 40 = ~17 min).
RELAY=0xEc34aA21cDe1366b397a99A4d90fc6B2f02cFaEa
MAX_RELAY_LAG_BLOCKS=40

# Operational accounts that pay gas: name:address pairs, one floor for all (MIN_ETH) or per name.
# Alarms name the account only, never its address.
WATCH_ETH=relayer1:0x...,relayer2:0x...,coordinator:0x...,bundler:0x...,market_maker:0x...,liquidator:0x...,swap_maker:0x...
MIN_ETH=0.01
MIN_ETH_RELAYER1=0.05

# O-7, mainnet beta: the beta stack's accounts on Base mainnet, when this watchdog watches both
# stacks (unset: not checked). Same name:address form; floors MIN_ETH_MAINNET or per name.
MAINNET_RPC_URL=
WATCH_ETH_MAINNET=coordinator:0x...,relayer:0x...,swap_maker:0x...
MIN_ETH_MAINNET=0.005
MAINNET_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
WATCH_USDC_MAINNET=swap_maker:0x...
MIN_USDC_MAINNET_SWAP_MAKER=500

# The paymaster's deposit at the EntryPoint (sponsored UserOps stop when it runs out).
ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PAYMASTER=0x86c16062083a64aDb333404204346C9e4E03bb1e
MIN_PAYMASTER_DEPOSIT_ETH=0.02

# Loan-token balances the bots need (6 decimals): the close market maker, the liquidator, the
# swap maker's USDC inventory (Buy orders lock it).
USDC=0x637BBA9C47190C7a1ab2412F72cF0A9c088dE58b
WATCH_USDC=market_maker:0x...,liquidator:0x...,swap_maker:0x...
MIN_USDC_MARKET_MAKER=100
MIN_USDC_SWAP_MAKER=100

# O-7: the demo wallet's TAZ (judge deployment only): alarms when the backend's /demo/status says
# it runs low (or the demo path is off). DEMO_STATUS_URL defaults to $BACKEND_URL/demo/status.
WATCH_DEMO_TAZ=1
DEMO_STATUS_URL=

# O-7: balances only a service reports, as name|url|field|floor (field may be a dotted path; the
# URL is never printed). The swap maker's inventory comes from its local-only endpoint (its config's
# "status_bind": "127.0.0.1:8096"; never proxied): free ZEC in zatoshi, lockable USDC in USDC units.
WATCH_JSON=swap_maker_zec|http://127.0.0.1:8096/inventory|zecFreeZat|50000000,swap_maker_usdc|http://127.0.0.1:8096/inventory|usdcFree|100000000

# R-11.3: alarm once the coverage cap is this full (locked and pending zatoshi over those plus the
# Intake's capRoom); the Registry and the Intake of the deployment.
REGISTRY=0x...
INTAKE=0x...
CAP_FILL_ALARM=0.70

# Tier 3: a missing signer bond stops new vaults.
SIGNER_BOND=0x...

# Where alarms go: a Slack- or Discord-compatible webhook, or an ntfy topic URL. Unset: printed only.
ALERT_WEBHOOK_URL=
ALERT_FORMAT=slack
ALERT_PREFIX=zecured
REPEAT_HOURS=6
WATCHDOG_STATE=/var/lib/zecured/watchdog.json
