# /etc/zecured/watchdog.env: every threshold and endpoint of infra/watchdog/watchdog.py (G1, G2, G3).
BACKEND_URL=http://127.0.0.1:8080
BASE_RPC_URL=https://sepolia.base.org

# The header relay must stay within this many Zcash blocks of the tip (25 s blocks: 40 = ~17 min).
RELAY=0xab07317f7B9390394271D9c03FE2E912C0E58FA5
MAX_RELAY_LAG_BLOCKS=40

# Operational accounts that pay gas: name:address pairs, one floor for all (MIN_ETH) or per name.
WATCH_ETH=relayer1:0x...,relayer2:0x...,coordinator:0x8f5C58C8B116aA70E43cf5Af418082415cEb5a65,bundler:0x...,market_maker:0x...,liquidator:0x...
MIN_ETH=0.01
MIN_ETH_RELAYER1=0.05

# The paymaster's deposit at the EntryPoint (sponsored UserOps stop when it runs out).
ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PAYMASTER=0x75eBCBcb9fa463D12D01660cB6D44dc027C384d7
MIN_PAYMASTER_DEPOSIT_ETH=0.02

# Loan-token balances the bots need (6 decimals).
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
WATCH_USDC=market_maker:0x...
MIN_USDC_MARKET_MAKER=100

# Tier 3: a missing signer bond stops new vaults.
SIGNER_BOND=0x...

# Where alarms go: a Slack- or Discord-compatible webhook, or an ntfy topic URL. Unset: printed only.
ALERT_WEBHOOK_URL=
ALERT_FORMAT=slack
ALERT_PREFIX=zecured
REPEAT_HOURS=6
WATCHDOG_STATE=/var/lib/zecured/watchdog.json
