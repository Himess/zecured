# Copy to .env.local and fill in. Every value is public: Next.js inlines NEXT_PUBLIC_* into
# the browser bundle at build time. Never put a secret here. Rebuild after changing them.

# Our backend (coordinator API + RPC / bundler / paymaster proxy). The browser talks to
# nothing else; the Content Security Policy only allows this origin besides the app itself.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# Base Sepolia contracts, from contracts/deployments/base-sepolia.json once deployed.
# Leave empty to use placeholders: the Registry / Adapter placeholder (0x…dEaD) matches the
# local signer network config, so off-chain owner signatures verify before deployment, and
# Base reads / sponsored transactions stay disabled until all of these are set.
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_ADAPTER=
NEXT_PUBLIC_MARKET_ID=
NEXT_PUBLIC_USDC=
NEXT_PUBLIC_ORACLE=
NEXT_PUBLIC_ZZEC=

# Real deployments on Base Sepolia (defaults shown).
NEXT_PUBLIC_MORPHO=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
NEXT_PUBLIC_IRM=0x46415998764C29aB2a25CbeA6254146D50D22687
