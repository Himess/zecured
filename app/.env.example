# Copy to .env.local and fill in. Every value is public: Next.js inlines NEXT_PUBLIC_* into
# the browser bundle at build time. Never put a secret here. Rebuild after changing them.

# Our backend (coordinator API + RPC / bundler / paymaster proxy). The browser talks to
# nothing else; the Content Security Policy only allows this origin besides the app itself.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# Pinned deployment (security review H-6). The app signs for and calls only these addresses;
# the backend's GET /config is checked against them, and any disagreement stops owner
# signatures, Base reads and sponsored transactions. A production build (next build / start)
# needs all of them: a missing pin keeps Base disabled. Only `next dev` may leave them empty,
# and then takes them from GET /config with an "unpinned development configuration" warning.
# Copy them from contracts/deployments/<network>.json (see README.md, "Pinning a deployment").
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_ADAPTER=
NEXT_PUBLIC_MARKET_ID=
NEXT_PUBLIC_USDC=
NEXT_PUBLIC_ORACLE=
NEXT_PUBLIC_ZZEC=
# The five signer addresses, comma-separated (the deployment file's "signers").
NEXT_PUBLIC_SIGNERS=

# Real deployments on Base Sepolia. Empty = these built-in defaults, which are pins too.
# NEXT_PUBLIC_MORPHO=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
# NEXT_PUBLIC_IRM=0x46415998764C29aB2a25CbeA6254146D50D22687

# Not configured here, read at runtime from GET /config: whether sponsored transactions are
# available, the collateral denominations, the confirmations and the deposit window.
