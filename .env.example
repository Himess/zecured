# Copy to .env and fill in. Never commit .env.

# --- Zcash ---
# ZECURED_ZCASH_NETWORK=testnet         # testnet | mainnet: the wallet's Zcash network (default testnet) and the
                                        # bots' (unset: the deployment's Base chain decides); nodes read network.json (D81)
LIGHTWALLETD_URL=                       # e.g. https://<host>:443 (see docs/ref/FACTS.md); must follow that network

# --- Base Sepolia ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=                   # funded with Base Sepolia ETH; deploys contracts, owns mocks
COORDINATOR_PRIVATE_KEY=                # sends deposit and inclusion proofs, keeper calls, commitSpend / confirmPayout (pays its own gas)
# ETHERSCAN_API_KEY=                    # optional: an Etherscan v2 key, to verify the contracts on Basescan (forge verify-contract)

# --- Account abstraction (used only by the backend proxy; never exposed to the browser) ---
BUNDLER_URL=
PAYMASTER_URL=

# --- Signer network (scripts/signer-network.sh) ---
COORDINATOR_ADDRESS=                    # the address of COORDINATOR_PRIVATE_KEY: nodes accept only its requests
SIGNER_ADDRESSES=                       # the five signers' attestation addresses, ascending (DeployZecured)
# SIGNER_1_PRIVATE_KEY .. SIGNER_5_PRIVATE_KEY: optional; without them each node generates its own key

# --- Logs (nodes, backend, bots, swap maker) ---
RUST_LOG=info                           # the default; debug lines carry Zcash heights: on this machine only, never shipped off it

# --- Backend ---
BACKEND_BIND=127.0.0.1:8080
DEMO_ADMIN_TOKEN=                       # protects the demo control panel
# ZECURED_TREASURY_KEYS=                # W-6: the signers' treasury keys file (never committed): registers bond-paid claims' derived recipients

# --- Theft demo (review T3-6, docs/TIER3.md § 8): its own keys, never the judge network's ---
# THEFT_DEMO=1 scripts/signer-network.sh init|start|status|stop
THEFT_DEMO_COORDINATOR_PRIVATE_KEY=
THEFT_DEMO_COORDINATOR_ADDRESS=
# THEFT_DEMO_SIGNER_1_PRIVATE_KEY .. _5: optional; without them each theft-demo node generates its own key
